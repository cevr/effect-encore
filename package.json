{
  "name": "effect-encore",
  "version": "0.14.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cevr/effect-encore.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test --tsconfig-override=tsconfig.json",
    "test:watch": "bun test --watch",
    "test:all": "bun run test",
    "gate": "concurrently -n type,lint,fmt,test,build -c blue,yellow,magenta,green,cyan \"bun run typecheck\" \"bun run lint:fix\" \"bun run fmt\" \"bun run test:all\" \"bun run build\"",
    "build": "bun --bun tsdown",
    "release": "bun run build && changeset publish",
    "version": "changeset version",
    "prepare": "lefthook install && effect-tsgo patch"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@effect/sql-sqlite-bun": "4.0.0-beta.75",
    "@effect/tsgo": "0.13.1",
    "@types/bun": "1.3.13",
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "concurrently": "^9.2.1",
    "effect": "4.0.0-beta.75",
    "effect-bun-test": "0.3.0",
    "lefthook": "^2.1.5",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.66"
  }
}
