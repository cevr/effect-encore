{
  "name": "effect-encore",
  "version": "0.31.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cevr/effect-encore.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "\"$npm_execpath\" test --tsconfig-override=tsconfig.json",
    "test:watch": "\"$npm_execpath\" test --watch",
    "test:all": "\"$npm_execpath\" run test",
    "gate": "\"$npm_execpath\" run --parallel \"gate:*\"",
    "gate:type": "tsc --noEmit",
    "gate:lint": "oxlint",
    "gate:fmt": "oxfmt --check",
    "gate:test": "\"$npm_execpath\" test --tsconfig-override=tsconfig.json",
    "gate:build": "\"$npm_execpath\" --bun tsdown",
    "build": "\"$npm_execpath\" --bun tsdown",
    "bench:actor": "bun scripts/benchmark-actor-messaging.ts",
    "bench:canonical-json": "bun scripts/benchmark-canonical-json.ts",
    "bench:workflow": "bun scripts/benchmark-workflow-messaging.ts",
    "release": "\"$npm_execpath\" run build && changeset publish",
    "version": "changeset version",
    "prepare": "lefthook install && effect-tsgo patch"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-sqlite-bun": "4.0.0-rc.112",
    "@effect/tsgo": "^0.41.0",
    "@types/bun": "1.4.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "effect": "4.0.0-rc.112",
    "effect-bun-test": "0.3.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-plugin-effect": "^0.12.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112 <5"
  },
  "packageManager": "bun@1.4.0"
}
